{
  "name": "aurex-sdk",
  "version": "0.2.0",
  "description": "Aurex AI FinOps SDK — local-first LLM cost shield, circuit breaker, and outcome gate.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aurex": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./hook": {
      "import": "./dist/hook.js",
      "require": "./dist/hook.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.12"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": { "optional": true },
    "litellm": { "optional": true },
    "@google/genai": { "optional": true },
    "ollama": { "optional": true },
    "@huggingface/inference": { "optional": true },
    "ioredis": { "optional": true },
    "@opentelemetry/api": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^0.10.0",
    "@huggingface/inference": "^3.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@types/node": "^22.0.0",
    "ioredis": "^5.4.2",
    "ioredis-mock": "^8.9.0",
    "ollama": "^0.5.13",
    "openai": "^4.89.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1",
    "zod": "^3.24.0"
  }
}
