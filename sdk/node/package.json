{
  "name": "aurex-sdk",
  "version": "0.2.0",
  "description": "Aurex AI FinOps SDK — local-first LLM cost shield, circuit breaker, and outcome gate.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aurex": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hook": {
      "import": "./dist/hook.js",
      "require": "./dist/hook.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.12"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": { "optional": true },
    "litellm": { "optional": true },
    "@google/genai": { "optional": true },
    "ollama": { "optional": true },
    "@huggingface/inference": { "optional": true },
    "ioredis": { "optional": true },
    "@opentelemetry/api": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
