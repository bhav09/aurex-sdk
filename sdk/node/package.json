{
  "name": "aurex-sdk",
  "version": "0.1.0",
  "description": "Aurex AI FinOps SDK — zero-code LLM cost auditing.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aurex": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hook": {
      "import": "./dist/hook.js",
      "require": "./dist/hook.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": { "optional": true },
    "litellm": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
