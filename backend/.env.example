# Database Configuration
DATABASE_URL=sqlite:///./aurex.db
# For PostgreSQL: postgresql://user:password@localhost/aurex

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
FRONTEND_URL=http://localhost:3000

# OAuth & Email Configuration (Optional for local dev)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
RESEND_API_KEY=your_resend_api_key

# LLM Provider API Keys (Optional — used for live cloud canary auto-tests when AUREX_RUN_LIVE_TESTS=1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Aurex SDK Runtime, Redis StateStore & CI Drift Configuration
AUREX_API_KEY=
AUREX_BASE_URL=http://localhost:8000/api/v1
AUREX_REDIS_URL=
AUREX_CACHE_TTL=5m
AUREX_STRICT_DRIFT=0
AUREX_RUN_LIVE_TESTS=0
